# Where the app sends API calls.
# Dev: leave as /api. Vite forwards it to VITE_PROXY_TARGET (no CORS needed).
# Production build: set the full backend URL, e.g. https://berly-backend.onrender.com/api
#   (the backend must then allow your site's origin in its CORS settings).
VITE_API_URL=/api
VITE_PROXY_TARGET=https://berly-backend.onrender.com
